FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

boundary
{
    inlet_hot
    {
        type            patch;
    }
    outlet_hot
    {
        type            patch;
    }
}

U
{
    // Tube axis = +Z; hot inlet −Z → outlet +Z (counterflow vs shell)
    // ṁ = 0.047 kg/s (Zahid Fig. 5 / GIT validation point)
    internalField   uniform (0 0 0.4);

    boundaryField
    {
        ".*"
        {
            type            fixedValue;
            value           uniform (0 0 0);
        }
        "procBoundary.*"
        {
            type            processor;
        }
        inlet_hot
        {
            type            flowRateInletVelocity;
            massFlowRate    0.037;
            rhoInlet        960;
            value           uniform (0 0 0.4);
        }
        outlet_hot
        {
            type            pressureInletOutletVelocity;
            value           uniform (0 0 0.4);
        }
    }
}

T
{
    // Fig. 6 legend max (assumed Tin_hot): 371.47 K
    internalField   uniform 371.47;

    boundaryField
    {
        ".*"
        {
            type            zeroGradient;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        inlet_hot
        {
            type            fixedValue;
            value           uniform 371.47;
        }
        outlet_hot
        {
            type            inletOutlet;
            inletValue      uniform 371.47;
            value           uniform 371.47;
        }
        "hot_fluid_to_.*"
        {
            type            compressible::turbulentTemperatureRadCoupledMixed;
            Tnbr            T;
            kappaMethod     fluidThermo;
            value           uniform 371.47;
        }
    }
}

omega
{
    // Former ε=0.1, k=0.001 → ω = ε/(Cμ k) ≈ 1111 (Cμ=0.09)
    internalField   uniform 1111;

    boundaryField
    {
        ".*"
        {
            type            omegaWallFunction;
            value           uniform 1111;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        inlet_hot
        {
            type            fixedValue;
            value           uniform 1111;
        }
        outlet_hot
        {
            type            inletOutlet;
            inletValue      uniform 1111;
            value           uniform 1111;
        }
    }
}

k
{
    internalField   uniform 0.001;

    boundaryField
    {
        ".*"
        {
            type            kqRWallFunction;
            value           uniform 0.001;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        inlet_hot
        {
            type            fixedValue;
            value           uniform 0.001;
        }
        outlet_hot
        {
            type            inletOutlet;
            inletValue      uniform 0.001;
            value           uniform 0.001;
        }
    }
}

nut
{
    internalField   uniform 0;

    boundaryField
    {
        ".*"
        {
            type            nutkWallFunction;
            value           uniform 0;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        inlet_hot
        {
            type            calculated;
            value           uniform 0;
        }
        outlet_hot
        {
            type            calculated;
            value           uniform 0;
        }
    }
}

p_rgh
{
    // Paper: pressure-outlet p = 0 (gauge)
    internalField   uniform 0;

    boundaryField
    {
        ".*"
        {
            type            fixedFluxPressure;
            value           uniform 0;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        outlet_hot
        {
            type            fixedValue;
            value           uniform 0;
        }
    }
}

p
{
    internalField   uniform 0;

    boundaryField
    {
        ".*"
        {
            type            calculated;
            value           uniform 0;
        }
        "procBoundary.*"
        {
            type            processor;
        }
    }
}


