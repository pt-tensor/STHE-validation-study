FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

T
{
    internalField   uniform 334.74;        // mid of Fig.6 Tin 298–371.47 K

    boundaryField
    {
        ".*"
        {
            type            zeroGradient;
        }
        "procBoundary.*"
        {
            type            processor;
        }
        "solid_to_.*"
        {
            type            compressible::turbulentTemperatureRadCoupledMixed;
            Tnbr            T;
            kappaMethod     solidThermo;
            value           uniform 334.74;
        }
        shellOuter
        {
            type            zeroGradient;  // adiabatic (paper)
        }
    }
}


